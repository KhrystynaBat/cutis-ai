# Copy to .env and set the secrets.

# --- runtime
ENVIRONMENT=development

# --- PostgreSQL
POSTGRES_DB=dermalab
POSTGRES_USER=dermalab
POSTGRES_PASSWORD=change-me-db-password
DB_HOST_PORT=55432

# --- backend
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:4200,http://localhost:8080
MAX_UPLOAD_MB=10
AI_ENABLED=true
MAX_CONCURRENT_ANALYSES=1
MAX_QUEUED_ANALYSES=10
ANALYSIS_TIMEOUT_SECONDS=300

# --- Gemini text explanation (empty key: the feature is off)
# key from Google AI Studio; the free tier may use requests to improve Google products
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# used when the main model is overloaded (503)
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# --- e-mail (log or smtp)
EMAIL_PROVIDER=log
PATIENT_EMAIL_NOTIFICATIONS=true
PATIENT_EMAIL_ATTACH_PDF=true
APP_BASE_URL=http://localhost:8080
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=dermalab.clinic2026@gmail.com
# Google app password
SMTP_PASSWORD=
SMTP_FROM=dermalab.clinic2026@gmail.com
SMTP_FROM_NAME=CutisAI
DISPLAY_TIMEZONE=Europe/Kyiv

# --- sessions (COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60
# confirm sign-in with a link sent by e-mail
LOGIN_EMAIL_CONFIRMATION=true
LOGIN_LINK_TTL_MINUTES=10

# --- first admin (app.cli create-admin)
ADMIN_EMAIL=dermalab.clinic2026@gmail.com
ADMIN_PASSWORD=

# --- paths on the host
MODELS_HOST_DIR=./models

# --- frontend
FRONTEND_HOST_PORT=8080
